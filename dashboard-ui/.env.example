# ═══════════════════════════════════════════════════════════════════════
# TALPHA Dashboard — mẫu cấu hình. Copy sang .env.local rồi điền.
# ═══════════════════════════════════════════════════════════════════════

# ─── Kho số Postgres (docs/POSTGRES.md) ───
# Chạy bằng docker compose thì compose đặt sẵn hai dòng này.
DATABASE_URL=postgresql://talpha:talpha@127.0.0.1:5433/talpha
# Mật khẩu hai vai chỉ đọc mà /api/query (4 tab Marketing, Sức khoẻ QC, Khách hàng, Market Intel)
# và "CEO hỏi" đăng nhập — phải trùng với lúc chạy migrate.
TALPHA_DOC_PASSWORD=

# ─── Google (TUỲ CHỌN) — đọc bảng đơn đối tác 3PL trên Google Sheet ───
# Dán JSON một dòng vào đây, hoặc để file bigquery_key.json ở gốc repo rồi bỏ trống dòng này.
GCP_SA_KEY_JSON=

# ─── Deployment ───
NEXT_PUBLIC_DEPLOYMENT_MODE=talpha
NEXT_PUBLIC_APP_NAME=TALPHA

# ─── Đăng nhập (NextAuth v5) ───
# AUTH_SECRET sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Người dùng nằm ở bảng Postgres `users` (15/11/2026). USERS_JSON / config/users.json cũ được
# chép vào bảng một lần ở bước migrate — không cần đặt nữa.

# ─── Chìa mã hoá khoá kết nối trong kho (bảng api_credentials) ───
# Chuỗi ngẫu nhiên dài, GIỮ KÍN, giống nhau ở dashboard và sync. Đổi / mất chìa là phải nhập lại
# mọi khoá ở /admin → Khoá kết nối. Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TALPHA_ENCRYPTION_KEY=

# Token Meta, key POS, token Pancake, key 17TRACK dưới đây có thể bỏ trống rồi nhập ở
# /admin → Khoá kết nối (lưu MÃ HOÁ ở bảng api_credentials, thắng giá trị cùng tên trong file này).

# ─── Meta Ads — cần cho tab Chi phí quảng cáo và Ads Command Center ───
TALPHA_META_ACCESS_TOKEN=
TALPHA_META_APP_SECRET=

# ─── Poscake POS Đài Loan — cần cho tab Sản phẩm & Kho ───
TALPHA_POSCAKE_TW_KEY=
TALPHA_PANCAKE_API_TOKEN=

# ─── 17TRACK — theo dõi vận đơn, cảnh báo hàng tới cửa hàng ───
# Khoá lấy ở https://admin.17track.net/api/settings → Security → Access Key.
# Nhiều tài khoản thì thêm TRACK17_API_KEY_2, TRACK17_API_KEY_3… — quota cộng dồn, mỗi
# mã chỉ đăng ký ở một khoá. Gỡ một khoá thì mã đã đăng ký ở khoá đó thôi được cập nhật.
TRACK17_API_KEY=
# TRACK17_API_KEY_2=

# ─── Tuỳ chọn ───
# DASHBOARD_API_KEY=   # bật thì /api/query bắt buộc có x-api-key
# TALPHA_SYNC_TOKEN=   # token cho job snapshot gọi vào
# GEMINI_API_KEY=      # ô "Hỏi dashboard" — nên nhập ở /admin → Khoá kết nối → tab Gemini (mã hoá trong kho)
